"""Estado transacional e regras de agenda da clínica."""
import json
import os
from pathlib import Path
import re
import shutil
import sqlite3
import threading
from datetime import datetime, timedelta

ROOT = Path(__file__).resolve().parent.parent


class Erro(Exception):
    def __init__(self, status, mensagem):
        self.status, self.mensagem = status, mensagem


def agora():
    return datetime.fromisoformat(os.environ['ATENDE_AGORA']) if os.environ.get('ATENDE_AGORA') else datetime.now()


def telefone(valor):
    if not isinstance(valor, str) or re.search(r'[^\d+()\s-]', valor):
        raise Erro(400, 'Telefone inválido')
    digitos = re.sub(r'\D', '', valor)
    if len(digitos) in (12, 13) and digitos.startswith('55'):
        digitos = digitos[2:]
    if len(digitos) not in (10, 11):
        raise Erro(400, 'Telefone inválido')
    return '+55' + digitos


class Clinica:
    def __init__(self, pasta):
        self.pasta = Path(pasta)
        self.pasta.mkdir(parents=True, exist_ok=True)
        config = self.pasta / 'clinica.json'
        if not config.exists():
            shutil.copyfile(ROOT / 'exemplos/clinica.json', config)
        self.cfg = json.loads(config.read_text(encoding='utf-8'))
        self.lock = threading.RLock()
        self.db = sqlite3.connect(self.pasta / 'estado.sqlite3', check_same_thread=False)
        self.db.row_factory = sqlite3.Row
        self.db.execute('PRAGMA foreign_keys=ON')
        self.db.executescript('''
            CREATE TABLE IF NOT EXISTS catalogo (tipo TEXT, id TEXT, dados TEXT, PRIMARY KEY(tipo,id));
            CREATE TABLE IF NOT EXISTS meta (chave TEXT PRIMARY KEY, valor TEXT);
            CREATE TABLE IF NOT EXISTS pacientes (
                id INTEGER PRIMARY KEY, nome TEXT NOT NULL, telefone TEXT UNIQUE,
                email TEXT, nascimento TEXT, consentimento_marketing INTEGER NOT NULL DEFAULT 0,
                nao_contatar INTEGER NOT NULL DEFAULT 0);
            CREATE TABLE IF NOT EXISTS agendamentos (
                id INTEGER PRIMARY KEY, paciente_id INTEGER NOT NULL REFERENCES pacientes(id),
                servico TEXT NOT NULL, profissional TEXT NOT NULL, inicio TEXT NOT NULL,
                fim TEXT NOT NULL, status TEXT NOT NULL);
            CREATE INDEX IF NOT EXISTS agenda_profissional ON agendamentos(profissional,inicio,fim);
        ''')
        with self.db:
            if not self.db.execute("SELECT 1 FROM meta WHERE chave='semeado'").fetchone():
                for tipo in ('servicos', 'profissionais', 'faq'):
                    for item in self.cfg.get(tipo, []):
                        item = dict(item)
                        if tipo != 'faq':
                            item.setdefault('ativo', True)
                        if tipo == 'profissionais':
                            item.setdefault('registro', None)
                            item.setdefault('horarios', None)
                        self.db.execute('INSERT INTO catalogo VALUES (?,?,?)', (tipo, item['id'], json.dumps(item)))
                self.db.execute("INSERT INTO meta VALUES ('semeado','1')")

    def catalogo(self, tipo):
        return [json.loads(r[0]) for r in self.db.execute('SELECT dados FROM catalogo WHERE tipo=? ORDER BY rowid', (tipo,))]

    def servico(self, ident):
        for s in self.catalogo('servicos'):
            if s['id'] == ident:
                return s
        raise Erro(404, 'Serviço inexistente')

    def paciente(self, ident):
        r = self.db.execute('SELECT * FROM pacientes WHERE id=?', (ident,)).fetchone()
        if not r:
            raise Erro(404, 'Paciente inexistente')
        p = dict(r)
        for k in ('consentimento_marketing', 'nao_contatar'):
            p[k] = bool(p[k])
        return p

    def criar_paciente(self, b):
        tel = telefone(b.get('telefone'))
        r = self.db.execute('SELECT id FROM pacientes WHERE telefone=?', (tel,)).fetchone()
        if r:
            return 200, {'id': r[0]}
        if not isinstance(b.get('nome'), str) or not b['nome'].strip():
            raise Erro(400, 'Nome obrigatório')
        c = self.db.execute('INSERT INTO pacientes(nome,telefone,email,nascimento,consentimento_marketing) VALUES (?,?,?,?,?)',
                            (b['nome'], tel, b.get('email'), b.get('nascimento'), bool(b.get('consentimento_marketing', False))))
        return 201, {'id': c.lastrowid}

    def candidatos(self, servico, data, profissional=None):
        s = self.servico(servico)
        dia = datetime.strptime(data, '%Y-%m-%d')
        if not s['ativo'] or data in self.cfg.get('feriados', []):
            return []
        resultado = []
        duracao = timedelta(minutes=s['duracao_min'])
        passo = timedelta(minutes=self.cfg['passo_min'])
        if passo.total_seconds() <= 0 or duracao.total_seconds() <= 0:
            raise Erro(422, 'Duração e passo devem ser positivos')
        limite = agora() + timedelta(hours=self.cfg['antecedencia_min_horas'])
        for p in self.catalogo('profissionais'):
            if not p['ativo'] or servico not in p['servicos'] or (profissional and profissional != p['id']):
                continue
            grade = p.get('horarios') if p.get('horarios') is not None else self.cfg['horarios']
            for ini, fim in grade.get(('seg', 'ter', 'qua', 'qui', 'sex', 'sab', 'dom')[dia.weekday()], []):
                t = datetime.fromisoformat(data + 'T' + ini)
                final = datetime.fromisoformat(data + 'T' + fim)
                while t + duracao <= final:
                    if t >= limite:
                        resultado.append({'inicio': t.isoformat(timespec='minutes'), 'profissional': p['id']})
                    t += passo
        return sorted(resultado, key=lambda h: (h['inicio'], h['profissional']))

    def livre(self, profissional, inicio, fim, ignorar=None):
        return not self.db.execute('''SELECT 1 FROM agendamentos WHERE profissional=?
            AND status IN ('agendado','confirmado','realizado','falta') AND inicio < ? AND fim > ?
            AND (? IS NULL OR id != ?) LIMIT 1''', (profissional, fim, inicio, ignorar, ignorar)).fetchone()

    def horarios(self, servico, data, profissional=None):
        duracao = self.servico(servico)['duracao_min']
        return [h for h in self.candidatos(servico, data, profissional) if self.livre(h['profissional'], h['inicio'],
                (datetime.fromisoformat(h['inicio']) + timedelta(minutes=duracao)).isoformat(timespec='minutes'))]

    def agendar(self, b, ident=None):
        self.paciente(b['paciente_id'])
        s = self.servico(b['servico'])
        inicio = b['inicio']
        try:
            datetime.strptime(inicio, '%Y-%m-%dT%H:%M')
        except (ValueError, TypeError):
            raise Erro(422, 'Horário inválido')
        candidatos = [h for h in self.candidatos(s['id'], inicio[:10], b.get('profissional')) if h['inicio'] == inicio]
        if not candidatos:
            raise Erro(422, 'Horário inválido')
        fim = (datetime.fromisoformat(inicio) + timedelta(minutes=s['duracao_min'])).isoformat(timespec='minutes')
        for h in candidatos:
            if self.livre(h['profissional'], inicio, fim, ident):
                valores = (b['paciente_id'], s['id'], h['profissional'], inicio, fim, 'agendado')
                if ident is None:
                    ident = self.db.execute('INSERT INTO agendamentos(paciente_id,servico,profissional,inicio,fim,status) VALUES (?,?,?,?,?,?)', valores).lastrowid
                else:
                    self.db.execute('UPDATE agendamentos SET paciente_id=?,servico=?,profissional=?,inicio=?,fim=?,status=? WHERE id=?', (*valores, ident))
                return self.agendamento(ident)
        raise Erro(409, 'Horário ocupado')

    def agendamento(self, ident):
        r = self.db.execute('SELECT a.*,p.telefone FROM agendamentos a JOIN pacientes p ON p.id=a.paciente_id WHERE a.id=?', (ident,)).fetchone()
        if not r:
            raise Erro(404, 'Agendamento inexistente')
        return dict(r)

    def listar_agenda(self, q):
        de = q.get('data', q.get('de', '0001-01-01'))
        ate = q.get('data', q.get('ate', '9999-12-31'))
        return [dict(r) for r in self.db.execute('''SELECT a.*,p.telefone FROM agendamentos a JOIN pacientes p ON p.id=a.paciente_id
            WHERE substr(inicio,1,10) BETWEEN ? AND ? AND (? IS NULL OR profissional=?) ORDER BY inicio,a.id''',
            (de, ate, q.get('profissional'), q.get('profissional')))]
"""CLI e transporte HTTP; cada requisição de domínio é uma transação."""
import argparse
import hmac
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import json
import re
import sys
from urllib.parse import parse_qs, urlsplit

from .core import Clinica, Erro, ROOT
from . import conversa


def rotear(c, metodo, rota, q, b):
    if metodo == 'GET' and rota == '/api/saude':
        return 200, {'ok': True, 'versao': (ROOT / 'VERSION').read_text().strip()}
    if metodo == 'GET' and rota == '/api/servicos':
        return 200, {'servicos': [s for s in c.catalogo('servicos') if s['ativo']]}
    if metodo == 'GET' and rota == '/api/horarios':
        return 200, {'horarios': c.horarios(q['servico'], q['data'], q.get('profissional'))}
    if metodo == 'POST' and rota == '/api/mensagens':
        return 200, {'respostas': conversa.conversar(c, b['telefone'], b['texto'])}
    if metodo == 'GET' and rota == '/api/atendimento-humano':
        return 200, {'fila': conversa.fila(c)}
    if metodo == 'GET' and rota == '/api/saida':
        return 200, {'mensagens': [dict(r) for r in c.db.execute('SELECT * FROM saida ORDER BY id')]}
    if metodo == 'POST' and rota == '/api/tarefas/rodar':
        return 200, conversa.rodar(c, b.get('agora'))
    if metodo == 'POST' and rota == '/api/espera':
        c.paciente(b['paciente_id'])
        c.servico(b['servico'])
        from datetime import datetime
        datetime.strptime(b['data'], '%Y-%m-%d')
        ident = c.db.execute('INSERT INTO espera(paciente_id,servico,data) VALUES (?,?,?)',
                             (b['paciente_id'], b['servico'], b['data'])).lastrowid
        return 201, {'id': ident}
    m = re.fullmatch(r'/api/pacientes/(\d+)/dados', rota)
    if metodo == 'GET' and m:
        return 200, conversa.dados_paciente(c, int(m[1]))
    if metodo == 'POST' and rota == '/api/pacientes':
        return c.criar_paciente(b)
    if metodo == 'POST' and rota == '/api/agendamentos':
        return 201, c.agendar(b)
    if metodo == 'GET' and rota == '/api/agendamentos':
        return 200, {'agendamentos': c.listar_agenda(q)}
    m = re.fullmatch(r'/api/agendamentos/(\d+)/(cancelar|remarcar|presenca)', rota)
    if metodo == 'POST' and m:
        ident, acao = int(m[1]), m[2]
        a = c.agendamento(ident)
        if acao == 'remarcar':
            return 200, c.agendar({**a, 'inicio': b['inicio']}, ident)
        if acao == 'presenca' and not isinstance(b.get('compareceu'), bool):
            raise Erro(400, 'compareceu deve ser booleano')
        status = 'cancelado' if acao == 'cancelar' else ('realizado' if b['compareceu'] else 'falta')
        if acao == 'cancelar':
            conversa.cancelar(c, ident)
        else:
            conversa.presenca(c, ident, b['compareceu'])
        return 200, {'status': status}
    raise Erro(404, 'Rota inexistente')


def main():
    parser = argparse.ArgumentParser(description='Atendimento da clínica')
    sub = parser.add_subparsers(dest='comando', required=True)
    serve = sub.add_parser('serve')
    serve.add_argument('--porta', type=int, default=8080)
    serve.add_argument('--host', default='127.0.0.1')
    serve.add_argument('--dados', required=True)
    args = parser.parse_args()
    if args.host != '127.0.0.1':
        parser.error('Neste ambiente o servidor só pode escutar em 127.0.0.1')
    clinica = Clinica(args.dados)
    conversa.iniciar(clinica)

    class Handler(BaseHTTPRequestHandler):
        def processar(self):
            url = urlsplit(self.path)
            publico = (self.command == 'GET' and url.path in ('/', '/recepcao', '/api/saude', '/api/servicos', '/api/horarios')) or (self.command == 'POST' and url.path == '/api/mensagens')
            try:
                if not publico and not hmac.compare_digest(self.headers.get('X-Token', '').encode(), str(clinica.cfg['token']).encode()):
                    raise Erro(401, 'Token inválido')
                tamanho = int(self.headers.get('Content-Length', '0'))
                if tamanho < 0 or tamanho > 1048576:
                    raise Erro(413, 'Corpo muito grande')
                b = json.loads(self.rfile.read(tamanho)) if tamanho else {}
                if not isinstance(b, dict):
                    raise Erro(400, 'Objeto JSON esperado')
                q = {k: v[-1] for k, v in parse_qs(url.query).items()}
                with clinica.lock, clinica.db:
                    status, resposta = rotear(clinica, self.command, url.path, q, b)
            except Erro as e:
                status, resposta = e.status, {'erro': e.mensagem}
            except (ValueError, KeyError, TypeError):
                status, resposta = 400, {'erro': 'Pedido inválido'}
            except Exception as e:
                print(f'Erro interno: {type(e).__name__}: {e}', file=sys.stderr)
                status, resposta = 500, {'erro': 'Erro interno'}
            conteudo = json.dumps(resposta, ensure_ascii=False).encode('utf-8')
            self.send_response(status)
            self.send_header('Content-Type', 'application/json; charset=utf-8')
            self.send_header('Content-Length', str(len(conteudo)))
            self.end_headers()
            self.wfile.write(conteudo)

        do_GET = do_POST = do_PUT = do_DELETE = processar

        def log_message(self, *args):
            pass

    servidor = ThreadingHTTPServer((args.host, args.porta), Handler)
    print(f'PORTA={servidor.server_port}', flush=True)
    try:
        servidor.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        servidor.server_close()
        clinica.db.close()
"""Conversa e notificações persistidas, compartilhadas por todos os canais."""
import json
import re
import unicodedata
from datetime import datetime, timedelta

from .core import Erro, agora, telefone


def normalizar(texto):
    texto = ''.join(c for c in unicodedata.normalize('NFD', texto.lower()) if unicodedata.category(c) != 'Mn')
    return ' '.join(re.sub(r'[^\w\s]', ' ', texto).split())


def iniciar(c):
    c.db.executescript('''
        CREATE TABLE IF NOT EXISTS sessoes (telefone TEXT PRIMARY KEY, dados TEXT NOT NULL);
        CREATE TABLE IF NOT EXISTS historico (id INTEGER PRIMARY KEY, paciente_id INTEGER,
            telefone TEXT, direcao TEXT, texto TEXT, quando TEXT);
        CREATE TABLE IF NOT EXISTS humanos (id INTEGER PRIMARY KEY, telefone TEXT, motivo TEXT,
            prioridade TEXT, status TEXT NOT NULL DEFAULT 'aberto');
        CREATE TABLE IF NOT EXISTS saida (id INTEGER PRIMARY KEY, tipo TEXT, telefone TEXT,
            paciente_id INTEGER, texto TEXT, agendamento_id INTEGER, quando TEXT,
            status TEXT NOT NULL DEFAULT 'simulado', respondida INTEGER NOT NULL DEFAULT 0, oferta TEXT);
        CREATE TABLE IF NOT EXISTS espera (id INTEGER PRIMARY KEY, paciente_id INTEGER,
            servico TEXT, data TEXT, status TEXT NOT NULL DEFAULT 'aguardando');
        CREATE TABLE IF NOT EXISTS retornos (id INTEGER PRIMARY KEY, agendamento_id INTEGER UNIQUE,
            paciente_id INTEGER, servico TEXT, data TEXT, avisado INTEGER NOT NULL DEFAULT 0);
    ''')


def paciente_tel(c, tel):
    r = c.db.execute('SELECT id FROM pacientes WHERE telefone=?', (tel,)).fetchone()
    return c.paciente(r[0]) if r else None


def registrar(c, tel, direcao, texto):
    p = paciente_tel(c, tel)
    c.db.execute('INSERT INTO historico(paciente_id,telefone,direcao,texto,quando) VALUES (?,?,?,?,?)',
                 (p['id'] if p else None, tel, direcao, texto, agora().isoformat(timespec='minutes')))


def enviar(c, pid, tipo, texto, agendamento_id=None, oferta=None):
    p = c.paciente(pid)
    if p['nao_contatar'] or not p['telefone']:
        return 0
    c.db.execute('''INSERT INTO saida(tipo,telefone,paciente_id,texto,agendamento_id,quando,oferta)
        VALUES (?,?,?,?,?,?,?)''', (tipo, p['telefone'], pid, texto, agendamento_id,
        agora().isoformat(timespec='minutes'), json.dumps(oferta) if oferta else None))
    registrar(c, p['telefone'], 'saida', texto)
    return 1


def cancelar(c, ident):
    a = c.agendamento(ident)
    if a['status'] == 'cancelado':
        return
    c.db.execute("UPDATE agendamentos SET status='cancelado' WHERE id=?", (ident,))
    e = c.db.execute('''SELECT e.* FROM espera e JOIN pacientes p ON p.id=e.paciente_id
        WHERE e.servico=? AND e.data=? AND e.status='aguardando' AND p.nao_contatar=0
        AND p.telefone IS NOT NULL ORDER BY e.id LIMIT 1''', (a['servico'], a['inicio'][:10])).fetchone()
    if e:
        oferta = {k: a[k] for k in ('servico', 'inicio', 'profissional')}
        oferta['paciente_id'] = e['paciente_id']
        oferta['espera_id'] = e['id']
        enviar(c, e['paciente_id'], 'espera', f"Vaga às {a['inicio'][11:]}. Responda 1 para agendar.", ident, oferta)
        c.db.execute("UPDATE espera SET status='ofertado' WHERE id=?", (e['id'],))


def presenca(c, ident, compareceu):
    a = c.agendamento(ident)
    status = 'realizado' if compareceu else 'falta'
    c.db.execute('UPDATE agendamentos SET status=? WHERE id=?', (status, ident))
    dias = c.servico(a['servico']).get('retorno_dias')
    if compareceu and dias is not None:
        data = (datetime.fromisoformat(a['inicio']) + timedelta(days=dias)).date().isoformat()
        c.db.execute('INSERT OR IGNORE INTO retornos(agendamento_id,paciente_id,servico,data) VALUES (?,?,?,?)',
                     (ident, a['paciente_id'], a['servico'], data))
    return status


def rodar(c, instante=None):
    t = datetime.fromisoformat(instante) if instante else agora()
    enviadas = 0
    for a in c.db.execute("SELECT * FROM agendamentos WHERE status='agendado' ORDER BY id").fetchall():
        if t < datetime.fromisoformat(a['inicio']) <= t + timedelta(hours=c.cfg['confirmacao_horas']):
            if not c.db.execute("SELECT 1 FROM saida WHERE tipo='confirmacao' AND agendamento_id=?", (a['id'],)).fetchone():
                data = datetime.fromisoformat(a['inicio']).strftime('%d/%m %H:%M')
                enviadas += enviar(c, a['paciente_id'], 'confirmacao',
                    f"Confirme {c.servico(a['servico'])['nome']} em {data}: 1 confirmar, 2 cancelar.", a['id'])
    for r in c.db.execute('SELECT * FROM retornos WHERE avisado=0 ORDER BY id').fetchall():
        if t >= datetime.fromisoformat(r['data']) - timedelta(days=c.cfg['retorno_aviso_dias']):
            n = enviar(c, r['paciente_id'], 'retorno', f"Está chegando seu retorno de {c.servico(r['servico'])['nome']}.", r['agendamento_id'])
            if n:
                c.db.execute('UPDATE retornos SET avisado=1 WHERE id=?', (r['id'],))
            enviadas += n
    return {'enviadas': enviadas, 'reenviadas': 0}


def abrir_humano(c, tel, motivo, prioridade):
    r = c.db.execute("SELECT id FROM humanos WHERE telefone=? AND status='aberto'", (tel,)).fetchone()
    if r:
        if prioridade == 'alta':
            c.db.execute('UPDATE humanos SET prioridade=?,motivo=? WHERE id=?', (prioridade, motivo, r[0]))
        return r[0]
    return c.db.execute('INSERT INTO humanos(telefone,motivo,prioridade) VALUES (?,?,?)', (tel, motivo, prioridade)).lastrowid


def fila(c):
    return [dict(r) for r in c.db.execute("SELECT h.*,p.nome FROM humanos h LEFT JOIN pacientes p ON p.telefone=h.telefone WHERE h.status='aberto' ORDER BY h.id")]


def opcoes_servicos(c):
    ss = [s for s in c.catalogo('servicos') if s['ativo']]
    return {'etapa': 'servico', 'opcoes': [s['id'] for s in ss],
            'texto': '\n'.join(f"{i} - {s['nome']}" for i, s in enumerate(ss, 1))}


def conversar(c, numero, texto):
    tel = telefone(numero)
    if not isinstance(texto, str):
        raise Erro(400, 'Texto obrigatório')
    registrar(c, tel, 'entrada', texto)
    r = c.db.execute('SELECT dados FROM sessoes WHERE telefone=?', (tel,)).fetchone()
    estado = json.loads(r[0]) if r else {}
    respostas = decidir(c, tel, texto, estado)
    c.db.execute('INSERT INTO sessoes VALUES (?,?) ON CONFLICT(telefone) DO UPDATE SET dados=excluded.dados', (tel, json.dumps(estado)))
    for resposta in respostas:
        registrar(c, tel, 'saida', resposta)
    return respostas


def decidir(c, tel, texto, estado):
    t = normalizar(texto)
    p = paciente_tel(c, tel)
    emergencias = ('dor no peito', 'falta de ar', 'desmaio', 'desmaiou', 'sangramento', 'sangrando', 'convulsao', 'suicidio', 'me matar', 'avc', 'infarto')
    if any(x in t for x in emergencias):
        estado.clear()
        abrir_humano(c, tel, texto, 'alta')
        return ['Ligue 192 ou procure um pronto-socorro imediatamente. Nossa equipe foi avisada.']
    if t in ('parar', 'sair', 'pare'):
        # Guarda a preferência mesmo antes de saber o nome.
        estado.clear()
        estado['nao_contatar'] = True
        if p:
            c.db.execute('UPDATE pacientes SET nao_contatar=1 WHERE id=?', (p['id'],))
        resposta = ['Você não vai mais receber mensagens.']
    else:
        resposta = None
    if c.db.execute("SELECT 1 FROM humanos WHERE telefone=? AND status='aberto'", (tel,)).fetchone():
        return []
    if resposta is not None:
        return resposta
    if any(x in t for x in ('atendente', 'humano', 'falar com alguem')):
        estado.pop('etapa', None)
        estado['falhas'] = 0
        abrir_humano(c, tel, texto, 'normal')
        return ['Vou chamar um atendente.']
    if estado.get('etapa'):
        estado['falhas'] = 0
        if t == 'cancelar':
            estado.pop('etapa', None)
            return ['Agendamento interrompido.']
        if estado['etapa'] == 'nome':
            if not texto.strip():
                return ['Qual é seu nome?']
            _, novo = c.criar_paciente({'nome': texto, 'telefone': tel})
            c.db.execute('UPDATE historico SET paciente_id=? WHERE telefone=? AND paciente_id IS NULL', (novo['id'], tel))
            if estado.get('nao_contatar'):
                c.db.execute('UPDATE pacientes SET nao_contatar=1 WHERE id=?', (novo['id'],))
            estado.update(opcoes_servicos(c))
            return [estado['texto']]
        indice = int(t) - 1 if t.isascii() and t.isdigit() else -1
        if not 0 <= indice < len(estado['opcoes']):
            return [estado['texto']]
        if estado['etapa'] == 'servico':
            servico = estado['opcoes'][indice]
            hs = []
            for d in range(c.cfg['janela_dias'] + 1):
                hs.extend(c.horarios(servico, (agora() + timedelta(days=d)).date().isoformat()))
                if len(hs) >= 3:
                    break
            hs = hs[:3]
            nomes = {p['id']: p['nome'] for p in c.catalogo('profissionais')}
            msg = '\n'.join(f"{i}) {datetime.fromisoformat(h['inicio']).strftime('%d/%m %H:%M')} com {nomes[h['profissional']]}" for i, h in enumerate(hs, 1))
            estado.update(etapa='horario', servico=servico, opcoes=hs, texto=msg or 'Sem horários livres. Digite cancelar para sair.')
            return [estado['texto']]
        h = estado['opcoes'][indice]
        try:
            a = c.agendar({'paciente_id': p['id'], 'servico': estado['servico'], **h})
        except Erro as e:
            if e.status not in (409, 422):
                raise
            return ['Horário ocupado ou indisponível. Digite cancelar para recomeçar.']
        estado.pop('etapa', None)
        return [f"Agendado para {datetime.fromisoformat(a['inicio']).strftime('%d/%m %H:%M')}."]
    pendente = c.db.execute('SELECT * FROM saida WHERE telefone=? ORDER BY id DESC LIMIT 1', (tel,)).fetchone()
    if pendente and not pendente['respondida']:
        acao = None
        if pendente['tipo'] == 'confirmacao':
            if t in ('1', 'sim', 'confirmo'):
                c.db.execute("UPDATE agendamentos SET status='confirmado' WHERE id=? AND status='agendado'", (pendente['agendamento_id'],))
                acao = 'Agendamento confirmado.'
            elif t in ('2', 'cancelar', 'nao'):
                cancelar(c, pendente['agendamento_id'])
                acao = 'Agendamento cancelado.'
        elif pendente['tipo'] == 'espera' and t in ('1', 'sim'):
            oferta = json.loads(pendente['oferta'])
            try:
                c.agendar(oferta)
                c.db.execute("UPDATE espera SET status='atendido' WHERE id=?", (oferta['espera_id'],))
                acao = 'Horário agendado.'
            except Erro as e:
                if e.status not in (409, 422):
                    raise
                acao = 'Horário ocupado ou indisponível.'
        if acao:
            estado['falhas'] = 0
            c.db.execute('UPDATE saida SET respondida=1 WHERE id=?', (pendente['id'],))
            return [acao]
    if any(x in t for x in ('agendar', 'marcar', 'consulta')):
        estado['falhas'] = 0
        if not p:
            estado['etapa'] = 'nome'
            return ['Qual é seu nome?']
        estado.update(opcoes_servicos(c))
        return [estado['texto']]
    comuns = set('que qual quais como onde para por com sem uma uns umas dos das seu sua seus suas voce voces vcs nos eles elas tem'.split())
    palavras = set(t.split())
    melhor, resposta = 0, None
    for item in c.catalogo('faq'):
        for pergunta in item['perguntas']:
            pp = {w for w in normalizar(pergunta).split() if len(w) >= 3 and w not in comuns}
            nota = len(pp & palavras) / len(pp) if pp else 0
            if nota >= .6 and nota > melhor:
                melhor, resposta = nota, item['resposta']
    if resposta is not None:
        estado['falhas'] = 0
        return [resposta]
    estado['falhas'] = estado.get('falhas', 0) + 1
    if estado['falhas'] >= 2:
        abrir_humano(c, tel, texto, 'normal')
    return ['Não entendi. Você pode pedir um atendente.']


def dados_paciente(c, ident):
    p = c.paciente(ident)
    return {'paciente': p, 'agendamentos': [a for a in c.listar_agenda({}) if a['paciente_id'] == ident],
            'mensagens': [dict(r) for r in c.db.execute('SELECT direcao,texto,quando FROM historico WHERE paciente_id=? ORDER BY id', (ident,))]}
"""Seção 9: campanha só com consentimento e trava por conselho."""
import pytest

from conftest import Servidor, com_conselho

CASOS = [
    # conselho, texto, violações esperadas (None = permitido)
    ("cfo", "Clareamento por R$ 300 em 10x sem juros", {"preco", "parcelamento"}),
    ("cfo", "Sorteio de um kit de escovas", {"sorteio_brinde"}),
    ("cfo", "Veja o antes e depois dos nossos pacientes", {"antes_depois"}),
    ("cfo", "Avaliação grátis este mês", {"gratuito"}),
    ("cfo", "Resultado garantido no seu sorriso", {"promessa_resultado"}),
    ("cfo", "O melhor dentista do Batel", {"melhor_profissional"}),
    ("cfo", "Semana da saúde bucal: agende sua revisão.", None),
    ("cfm", "Consulta por R$ 300 nesta semana", None),
    ("cfm", "Participe do sorteio de um check-up", {"sorteio_brinde"}),
    ("cfm", "Consórcio para sua cirurgia", {"consorcio"}),
    ("cfm", "Melhor médico da cidade, 100% de satisfação", {"melhor_profissional", "promessa_resultado"}),
    ("coffito", "Promoção de pilates clínico", {"promocao"}),
    ("coffito", "Sessão por apenas 80 reais", {"preco"}),
    ("coffito", "Novas turmas de pilates clínico às terças", None),
    ("estetica", "Limpeza de pele por R$ 120 com desconto", None),
    ("estetica", "Resultado garantido em 1 sessão", {"promessa_resultado"}),
]


@pytest.mark.parametrize("conselho,texto,esperado", CASOS, ids=[f"{c[0]}-{i}" for i, c in enumerate(CASOS)])
def test_trava_por_conselho(dados, conselho, texto, esperado):
    com_conselho(dados, conselho)
    s = Servidor(dados)
    try:
        api = s.subir()
        api.paciente("Maria", "41999990001", marketing=True)
        st, r = api.post("/api/campanhas", {"texto": texto})
        if esperado is None:
            assert st == 200 and r["enviadas"] == 1, (st, r)
        else:
            assert st == 422, (st, r)
            assert set(r["violacoes"]) == esperado
            assert api.saida("campanha") == []
    finally:
        s.parar()


def test_publico_so_com_consentimento_e_sem_parar(api):
    api.paciente("Com", "41999990001", marketing=True)
    api.paciente("Sem", "41999990002", marketing=False)
    api.paciente("Parou", "41999990003", marketing=True)
    api.msg("41999990003", "parar")
    st, r = api.post("/api/campanhas", {"texto": "Semana da saúde bucal: agende sua revisão."})
    assert st == 200 and r["enviadas"] == 1
    assert [m["telefone"] for m in api.saida("campanha")] == ["+5541999990001"]
"""Seções 10 e 11: direitos do titular (LGPD) e exportação para o Painel de Recuperação do Raio-X."""
import json
import subprocess
import unicodedata

from conftest import RAIZ, Servidor

DISPONIVEL_OUT = 22560  # minutos de out/2026: 21 dias úteis (sem 12/10) × 480 + 5 sábados × 240, × 2 profissionais


def norm(s):
    return "".join(c for c in unicodedata.normalize("NFD", s.lower()) if unicodedata.category(c) != "Mn")


def test_dados_e_exclusao(api):
    tel = "41999990001"
    pid = api.paciente("Maria Silva", tel, marketing=True)
    _, a = api.agenda(pid, "2026-10-07T09:00", profissional="ana")
    _, b = api.agenda(pid, "2026-10-08T09:00", profissional="ana")
    api.post(f"/api/agendamentos/{b['id']}/presenca", {"compareceu": True})
    api.msg(tel, "tem estacionamento")
    st, d = api.get(f"/api/pacientes/{pid}/dados")
    assert st == 200
    assert d["paciente"]["nome"] == "Maria Silva" and d["paciente"]["telefone"] == "+5541999990001"
    assert {x["id"] for x in d["agendamentos"]} == {a["id"], b["id"]}
    assert {"entrada", "saida"} <= {m["direcao"] for m in d["mensagens"]}
    assert any("estacionamento" in m["texto"] for m in d["mensagens"])

    assert api.delete(f"/api/pacientes/{pid}")[0] == 204
    st, d = api.get(f"/api/pacientes/{pid}/dados")
    assert d["paciente"]["nome"] == "removido" and d["paciente"]["telefone"] is None
    status = {x["id"]: x["status"] for x in d["agendamentos"]}
    assert status == {a["id"]: "cancelado", b["id"]: "realizado"}
    assert d["mensagens"] and all(m["texto"] == "" for m in d["mensagens"])
    st, r = api.get("/api/raiox?mes=2026-10")
    assert r["valores"]["atendimentos_mes"] == 1
    assert "nome" in norm(api.msg(tel, "quero agendar"))  # telefone virou desconhecido


def montar_mes(dados):
    """Abril: dois atendimentos de limpeza que geram retorno em 05/10 e 06/10. Outubro: o cenário medido."""
    s = Servidor(dados, agora="2026-04-01T09:00")
    api = s.subir()
    p6 = api.paciente("Seis", "41900000006")
    p7 = api.paciente("Sete", "41900000007")
    for pid, dia in ((p6, "2026-04-08"), (p7, "2026-04-09")):
        st, a = api.agenda(pid, f"{dia}T09:00", "limpeza", "ana")
        assert st == 201, a
        api.post(f"/api/agendamentos/{a['id']}/presenca", {"compareceu": True})
    s.parar()

    s = Servidor(dados)  # agora = 06/10/2026 09:00
    api = s.subir()
    p1, p2, p3, p4, p5 = (api.paciente(n, f"4190000000{i}") for i, n in enumerate(["Um", "Dois", "Tres", "Quatro", "Cinco"], 1))

    def marca(pid, inicio, servico, prof, compareceu=None):
        st, a = api.agenda(pid, inicio, servico, prof)
        assert st == 201, (inicio, a)
        if compareceu is not None:
            api.post(f"/api/agendamentos/{a['id']}/presenca", {"compareceu": compareceu})
        return a

    marca(p1, "2026-10-07T08:00", "avaliacao", "ana", True)     # 30 min, novo
    marca(p1, "2026-10-07T08:30", "limpeza", "ana", True)       # 60 min
    marca(p2, "2026-10-07T08:00", "avaliacao", "bruno", False)  # 30 min, falta
    marca(p3, "2026-10-08T08:00", "avaliacao", "bruno", True)   # 30 min, novo
    marca(p4, "2026-10-08T08:00", "avaliacao", "ana")           # 30 min, agendado (ativo)
    c = marca(p5, "2026-10-08T09:00", "avaliacao", "ana")       # cancelado: não conta
    api.post(f"/api/agendamentos/{c['id']}/cancelar")
    marca(p6, "2026-10-07T10:00", "limpeza", "ana", True)       # 60 min, cumpre o retorno de 05/10
    return s, api


def test_raiox_numeros_do_mes(dados):
    s, api = montar_mes(dados)
    try:
        st, r = api.get("/api/raiox?mes=2026-10")
        assert st == 200 and r["pacote"] == "clinica" and r["mes"] == "2026-10"
        v = r["valores"]
        assert v["atendimentos_mes"] == 4
        assert v["falta_pct"] == 20.0
        assert v["clientes_novos_mes"] == 2
        assert v["retorno_atual_pct"] == 50.0
        assert abs(v["ocupacao_pct"] - 240 / DISPONIVEL_OUT * 100) <= 0.06
        st, abr = api.get("/api/raiox?mes=2026-04")
        assert abr["valores"]["atendimentos_mes"] == 2 and abr["valores"]["clientes_novos_mes"] == 2
        assert abr["valores"]["falta_pct"] == 0
    finally:
        s.parar()


def test_cli_grava_mes_no_acompanhamento_do_painel(dados, tmp_path):
    s, _ = montar_mes(dados)
    s.parar()
    arq = tmp_path / "acompanhamento.json"
    arq.write_text(json.dumps({
        "tipo": "acompanhamento", "pacote": "clinica", "cliente": "Clínica Sorriso",
        "base": {"data": "2026-09-01", "valores": {"falta_pct": 18, "ticket_medio": 250, "atendimentos_mes": 400}},
        "meses": [],
    }))
    cmd = [str(RAIZ / "atende"), "raiox", "--dados", str(dados), "--mes", "2026-10", "--acompanhamento", str(arq)]
    for _ in range(2):  # rodar duas vezes substitui o mês, não duplica
        assert subprocess.run(cmd, cwd=RAIZ, capture_output=True, timeout=30).returncode == 0
    acomp = json.loads(arq.read_text())
    assert acomp["tipo"] == "acompanhamento" and acomp["base"]["valores"]["falta_pct"] == 18
    [m] = acomp["meses"]
    assert m["mes"] == "2026-10" and m["obs"] == "atende-clinica"
    assert m["valores"]["ticket_medio"] == 250          # mesclado da base
    assert m["valores"]["falta_pct"] == 20.0            # medido
    assert m["valores"]["atendimentos_mes"] == 4
